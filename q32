#include<iostream>
using namespace std;

int main(){
    int x[5];

    for(int i = 0; i < 5; i++){
        cout << "enter the number " << i + 1 << " : ";
        cin >> x[i];
    }

    int max = x[0];
    for(int i = 1; i < 5; i++){
        if(max < x[i])
            max = x[i];
    }

    int second_max = -2147483648; // INT_MIN

    for(int i = 0; i < 5; i++){
        if(x[i] != max && x[i] > second_max){
            second_max = x[i];
        }
    }

    cout << "the maximum no. is : " << max << endl;
    cout << "the 2nd maximum no. is : " << second_max;

    return 0;
}
